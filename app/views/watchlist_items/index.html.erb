<% content_for :title, "Watchlist · T0 Trader" %>
<div class="flex items-center justify-between mb-6">
  <div>
    <div class="page-title">Watchlist — canh mua</div>
    <div class="page-sub">Theo dõi mã tiềm năng và nhận email khi giá về vùng bạn muốn mua (tránh mua đuổi/FOMO).</div>
  </div>
  <%= button_to refresh_stocks_path, class: "btn btn-ghost" do %>Cập nhật giá<% end %>
</div>

<div class="card mb-5">
  <div class="card-title mb-3">Thêm mã theo dõi</div>
  <%= form_with url: watchlist_items_path, method: :post, class: "grid gap-3", data: { turbo: false } do %>
    <div class="grid gap-3" style="grid-template-columns: 1fr 1fr 1.4fr auto; align-items:end;">
      <div class="ac-wrap" data-controller="autocomplete" data-autocomplete-url-value="<%= symbols_search_path %>">
        <label class="form-label">Mã</label>
        <%= text_field_tag :symbol, nil, class: "form-input", style: "text-transform:uppercase", placeholder: "Gõ mã hoặc tên...", autocomplete: "off",
              data: { autocomplete_target: "input", action: "input->autocomplete#onInput keydown->autocomplete#onKey" } %>
        <div class="ac-list" data-autocomplete-target="list"></div>
      </div>
      <div>
        <label class="form-label">Giá muốn mua (đ)</label>
        <%= text_field_tag :target_buy_price, nil, inputmode: "numeric", class: "form-input", placeholder: "120.000", data: { controller: "numeric-input" } %>
      </div>
      <div>
        <label class="form-label">Ghi chú</label>
        <%= text_field_tag :note, nil, class: "form-input", placeholder: "Lý do quan tâm..." %>
      </div>
      <%= submit_tag "Thêm", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<div class="card">
  <% if @items.any? %>
    <div style="overflow-x:auto">
      <table class="data-table">
        <thead><tr><th>Mã</th><th>Theo dõi</th><th class="num">Giá hiện tại</th><th class="num">Giá muốn mua</th><th class="num">Chênh lệch</th><th>Ghi chú</th><th></th></tr></thead>
        <tbody>
          <% @items.each do |item| %>
            <% price = item.stock.current_price %>
            <% hit = item.target_hit?(price) %>
            <tr style="<%= 'opacity:.5' unless item.active? %>">
              <td class="sym"><span class="flex items-center gap-1"><%= item.stock.symbol %> <%= chart_btn(item.stock.symbol) %></span><div style="font-size:11px;color:#7182a3;font-weight:400"><%= item.stock.name %></div></td>
              <td>
                <%= button_to toggle_watchlist_item_path(item), method: :patch, class: "switch #{'switch-on' if item.active?}", form: { style: "margin:0" } do %>
                  <span class="switch-knob"></span>
                <% end %>
              </td>
              <td class="num"><%= price ? vnd(price, unit: "") : "—" %></td>
              <td class="num"><%= item.target_buy_price ? vnd(item.target_buy_price, unit: "") : "—" %></td>
              <td class="num">
                <% if !item.active? %><span style="color:#5b6784">đã tắt</span>
                <% elsif price && item.target_buy_price %>
                  <% diff = ((price - item.target_buy_price) / item.target_buy_price.to_f * 100).round(1) %>
                  <% if hit %><span class="badge badge-settled">Đã về vùng mua</span>
                  <% else %><span style="color:#8595b4">còn <%= diff %>%</span><% end %>
                <% else %>—<% end %>
              </td>
              <td style="color:#8595b4"><%= item.note %></td>
              <td class="flex gap-1">
                <%= link_to "Mua", new_trade_path(side: "buy", symbol: item.stock.symbol, price: item.target_buy_price&.to_i), class: "btn btn-ghost btn-sm" %>
                <%= button_to "Xoá", watchlist_item_path(item), method: :delete, class: "btn btn-danger btn-sm",
                      form: { data: { turbo_confirm: "Xoá #{item.stock.symbol} khỏi watchlist?" } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">Watchlist trống. Thêm mã bạn đang canh mua ở trên.</div>
  <% end %>
</div>
