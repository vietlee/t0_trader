<%# locals: f, method, label, autocomplete:, placeholder:, autofocus: (optional) %>
<%= f.label method, label, class: "form-label" %>
<div class="pw-wrap" data-controller="password-toggle">
  <%= f.password_field method,
        autocomplete: local_assigns.fetch(:autocomplete, "current-password"),
        autofocus: local_assigns.fetch(:autofocus, false),
        class: "form-input",
        placeholder: local_assigns.fetch(:placeholder, "••••••••"),
        data: { password_toggle_target: "input" } %>
  <button type="button" class="pw-eye" data-action="password-toggle#toggle" data-password-toggle-target="eye" aria-label="Hiện/ẩn mật khẩu" tabindex="-1">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
  </button>
</div>
