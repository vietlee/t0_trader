<%= form_with model: stock do |f| %>
  <% if stock.errors.any? %>
    <div class="flash flash-alert"><%= stock.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="form-row" style="grid-template-columns: 1fr 1fr;">
    <div>
      <%= f.label :symbol, "Mã", class: "form-label" %>
      <%= f.text_field :symbol, class: "form-input", style:"text-transform:uppercase", placeholder: "FPT" %>
    </div>
    <div>
      <%= f.label :exchange, "Sàn", class: "form-label" %>
      <%= f.select :exchange, Stock::EXCHANGES, {}, class: "form-select" %>
    </div>
  </div>
  <div class="form-row mt-4" style="grid-template-columns: 1fr 1fr;">
    <div>
      <%= f.label :name, "Tên công ty", class: "form-label" %>
      <%= f.text_field :name, class: "form-input", placeholder: "CTCP FPT" %>
    </div>
    <div>
      <%= f.label :sector, "Ngành", class: "form-label" %>
      <%= f.text_field :sector, class: "form-input", placeholder: "Công nghệ" %>
    </div>
  </div>
  <div class="mt-4" style="max-width:260px">
    <%= f.label :current_price, "Giá hiện tại (đ)", class: "form-label" %>
    <%= f.text_field :current_price, value: stock.current_price&.to_i, inputmode: "numeric", class: "form-input", placeholder: "138.000",
          data: { controller: "numeric-input" } %>
  </div>
  <div class="flex gap-3 mt-5">
    <%= f.submit (stock.persisted? ? "Lưu" : "Thêm mã"), class: "btn btn-primary" %>
    <%= link_to "Huỷ", stocks_path, class: "btn btn-ghost" %>
    <% if stock.persisted? %>
      <%= button_to "Xoá mã", stock_path(stock), method: :delete, class: "btn btn-danger", style:"margin-left:auto",
            form: { data: { turbo_confirm: "Xoá mã #{stock.symbol}?" } } %>
    <% end %>
  </div>
<% end %>
