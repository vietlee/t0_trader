<% content_for :title, "Vị thế & T+0 · T0 Trader" %>
<div class="flex items-center justify-between mb-6">
  <div>
    <div class="page-title">Vị thế & Kiểm soát T+0</div>
    <div class="page-sub">Biết chính xác mỗi mã bán được bao nhiêu <b style="color:#6ee7b7">hôm nay</b> và bao nhiêu đang chờ về.</div>
  </div>
  <div class="flex gap-2">
    <%= button_to refresh_stocks_path, class: "btn btn-ghost" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      Tự lấy giá
    <% end %>
    <%= link_to new_trade_path, class: "btn btn-primary" do %>+ Ghi giao dịch<% end %>
  </div>
</div>

<div class="kpi-grid mb-5">
  <div class="card kpi"><div class="kpi-label">Giá trị CP đang giữ</div><div class="kpi-value" title="<%= vnd(@market_value) %>"><%= vnd_short(@market_value) %></div></div>
  <div class="card kpi"><div class="kpi-label">Lãi/lỗ chưa hiện thực</div><div class="kpi-value <%= pnl_color(@unrealized) %>"><%= @unrealized >= 0 ? "+" : "" %><%= vnd_short(@unrealized) %></div></div>
  <div class="card kpi" style="border-color:rgba(16,185,129,.3)"><div class="kpi-label" style="color:#6ee7b7">⚡ Sẵn sàng bán hôm nay</div><div class="kpi-value" style="color:#6ee7b7"><%= number_with_delimiter(@total_available, delimiter: ".") %> <span style="font-size:14px;color:#8595b4">CP</span></div></div>
  <div class="card kpi" style="border-color:rgba(245,158,11,.3)"><div class="kpi-label" style="color:#fcd34d">Đang về (T+)</div><div class="kpi-value" style="color:#fcd34d"><%= number_with_delimiter(@total_pending, delimiter: ".") %> <span style="font-size:14px;color:#8595b4">CP</span></div></div>
</div>

<% if @nav.positive? && @max_position_pct.positive? %>
  <% concentrated = @positions.select { |p| p.market_value.to_f / @nav * 100 > @max_position_pct } %>
  <% if concentrated.any? %>
    <div class="flash flash-alert mb-5">
      ⚠ <b>Tập trung cao:</b> <%= concentrated.map { |p| "#{p.stock.symbol} #{(p.market_value.to_f / @nav * 100).round(1)}%" }.join(", ") %>
      vượt ngưỡng <%= @max_position_pct.to_i %>% NAV. Cân nhắc giảm tỷ trọng để phân tán rủi ro.
    </div>
  <% end %>
<% end %>

<% if @positions.any? %>
  <div class="card mb-5">
    <div class="card-header"><div class="card-title">Chi tiết vị thế</div></div>
    <div style="overflow-x:auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>Mã</th><th class="num">Tổng KL</th>
            <th class="num" style="color:#6ee7b7">Bán được</th><th class="num" style="color:#fcd34d">Đang về</th>
            <th class="num">Giá vốn</th><th class="num">Giá TT</th><th class="num">Giá trị vốn</th><th class="num">Giá trị TT</th><th class="num">Lãi/lỗ</th><th>Gợi ý</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% @positions.each do |pos| %>
            <tr>
              <td class="sym"><span class="flex items-center gap-1"><%= pos.stock.symbol %> <%= chart_btn(pos.stock.symbol) %></span><div style="font-size:11px;color:#7182a3;font-weight:400"><%= pos.stock.name %></div></td>
              <td class="num"><%= number_with_delimiter(pos.quantity, delimiter: ".") %></td>
              <td class="num" style="color:#6ee7b7;font-weight:700"><%= number_with_delimiter(pos.available_qty, delimiter: ".") %></td>
              <td class="num" style="color:#fcd34d"><%= pos.pending_qty.positive? ? number_with_delimiter(pos.pending_qty, delimiter: ".") : "—" %></td>
              <td class="num"><%= vnd(pos.avg_cost, unit: "") %></td>
              <td class="num"><%= pos.market_price ? vnd(pos.market_price, unit: "") : "—" %></td>
              <td class="num" style="color:#aab6d0"><%= vnd_short(pos.cost_basis) %></td>
              <td class="num"><%= vnd_short(pos.market_value) %></td>
              <td class="num"><%= pnl(pos.unrealized, short: true) %> <span style="font-size:11px"><%= pnl_pct(pos.unrealized_pct) %></span></td>
              <td><%= position_suggestion(pos.unrealized_pct, current_user.alert_threshold_pct) if pos.market_price %></td>
              <td class="flex gap-1" style="white-space:nowrap">
                <% if pos.available_qty.positive? %>
                  <%= link_to "Bán", new_trade_path(side: "sell", stock_id: pos.stock.id), class: "btn btn-danger btn-sm" %>
                <% end %>
                <%= link_to "Mua", new_trade_path(side: "buy", stock_id: pos.stock.id), class: "btn btn-ghost btn-sm" %>
              </td>
            </tr>
            <% if pos.pending_lots.any? %>
              <tr><td colspan="11" style="padding-top:0;border:none">
                <div style="display:flex;gap:8px;flex-wrap:wrap;padding:2px 4px 10px">
                  <% pos.pending_lots.each do |lot| %>
                    <span class="chip" style="background:rgba(245,158,11,.1);color:#fcd34d">
                      <span class="tag-dot" style="background:#f59e0b"></span>
                      <%= number_with_delimiter(lot[:qty], delimiter: ".") %> CP về <%= lot[:settlement_date]&.strftime("%d/%m") %>
                      <% if lot[:sessions] %>(còn <%= lot[:sessions] %> phiên)<% end %>
                    </span>
                  <% end %>
                </div>
              </td></tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mb-5">
    <div class="card-header">
      <div class="card-title">🎯 Kế hoạch cắt lỗ / chốt lời</div>
      <%= link_to "Tính khối lượng theo rủi ro →", position_size_tool_path, class: "chip", style: "color:#6ee7b7" %>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px">
      <% @positions.each do |pos| %>
        <% rt = @risk_targets[pos.stock.id] %>
        <%= form_with url: risk_targets_path, method: :post, class: "sltp-row" do %>
          <%= hidden_field_tag :stock_id, pos.stock.id %>
          <div class="sltp-sym">
            <span class="sym"><%= pos.stock.symbol %></span>
            <span style="font-size:11px;color:#7182a3">vốn <%= vnd(pos.avg_cost, unit: "") %> · TT <%= pos.market_price ? vnd(pos.market_price, unit: "") : "—" %></span>
            <% if rt&.stop_hit?(pos.market_price) %><span class="badge badge-cancelled" style="font-size:9px">chạm SL</span>
            <% elsif rt&.target_hit?(pos.market_price) %><span class="badge badge-settled" style="font-size:9px">chạm TP</span><% end %>
          </div>
          <div class="sltp-field">
            <label class="form-label" style="margin-bottom:3px">Cắt lỗ</label>
            <%= text_field_tag :stop_loss, rt&.stop_loss&.to_i, inputmode: "numeric", class: "form-input", style: "padding:7px 9px", placeholder: "vd 25.000", data: { controller: "numeric-input" } %>
          </div>
          <div class="sltp-field">
            <label class="form-label" style="margin-bottom:3px">Chốt lời</label>
            <%= text_field_tag :take_profit, rt&.take_profit&.to_i, inputmode: "numeric", class: "form-input", style: "padding:7px 9px", placeholder: "vd 30.000", data: { controller: "numeric-input" } %>
          </div>
          <%= submit_tag "Lưu", class: "btn btn-ghost btn-sm", style: "align-self:end" %>
        <% end %>
      <% end %>
    </div>
    <div class="form-hint mt-2">Đặt SL/TP để hệ thống email nhắc khi giá chạm (cần bật cảnh báo trong Cài đặt + có giá tự động). Để trống cả hai để xoá.</div>
  </div>

  <div class="card" style="background:rgba(16,185,129,.06);border-color:rgba(16,185,129,.2)">
    <div class="card-title" style="color:#6ee7b7;margin-bottom:8px">💡 Chiến thuật T+0</div>
    <div style="font-size:13.5px;color:#c7d3e8;line-height:1.65">
      Giữ một lượng <b>hàng đã về</b> (cột "Bán được") làm "kho" cho mỗi mã bạn giao dịch thường xuyên.
      Khi giá tăng trong phiên, bán ra từ kho có sẵn để chốt lời; sau đó mua lại để bù kho — lô mua mới sẽ về sau 2 phiên.
      Nhờ vậy bạn xoay vòng được trong ngày mà không bị kẹt T+2. Chia lệnh mua thành nhiều lô ở các phiên khác nhau
      để luôn có hàng sẵn sàng.
    </div>
  </div>
<% else %>
  <div class="card"><div class="empty-state">Chưa có vị thế đang mở. <%= link_to "Ghi giao dịch mua", new_trade_path(side: "buy"), style:"color:#6ee7b7" %></div></div>
<% end %>
