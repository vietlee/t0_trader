<% ico = ->(path) { raw(%(<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">#{path}</svg>)) } %>
<aside class="sidebar">
  <%= link_to root_path, class: "brand", style: "text-decoration:none" do %>
    <div class="brand-mark">T0</div>
    <div>
      <div class="brand-name">T0 Trader</div>
      <div class="brand-sub">VNDirect · T+0 control</div>
    </div>
  <% end %>

  <%= nav_link "Tổng quan", root_path, ico.call('<rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/>') %>
  <%= nav_link "Vị thế & T+0", positions_path, ico.call('<path d="M3 12h4l3 8 4-16 3 8h4"/>') %>
  <%= nav_link "Giao dịch", trades_path, ico.call('<path d="M7 7h10M7 7l3-3M7 7l3 3"/><path d="M17 17H7M17 17l-3 3M17 17l-3-3"/>') %>
  <%= nav_link "Watchlist", watchlist_items_path, ico.call('<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>') %>
  <%= nav_link "Mã & Giá", stocks_path, ico.call('<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3 2.4c-.9.3-1.5 1-1.5 2M12 17h.01"/>') %>
  <%= nav_link "Dòng tiền", cash_flows_path, ico.call('<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/>') %>
  <%= nav_link "Báo cáo", reports_path, ico.call('<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>') %>

  <div class="nav-section">Trợ lý AI</div>
  <%= nav_link "Phân tích AI", ai_insights_path, ico.call('<path d="M12 3l2 4 4 .5-3 3 .8 4.3L12 16l-3.8 1.8.8-4.3-3-3 4-.5z"/>') %>
  <%= nav_link "AI Coach", ai_coach_path, ico.call('<path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/>') %>

  <div style="margin-top:auto"></div>
  <div class="nav-section">Hệ thống</div>
  <%= nav_link "Cài đặt", settings_path, ico.call('<circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1.3l2-1.5-2-3.4-2.3 1a7 7 0 0 0-2.3-1.3L14 2h-4l-.3 2.5a7 7 0 0 0-2.3 1.3l-2.3-1-2 3.4 2 1.5A7 7 0 0 0 5 12a7 7 0 0 0 .1 1.3l-2 1.5 2 3.4 2.3-1a7 7 0 0 0 2.3 1.3L10 22h4l.3-2.5a7 7 0 0 0 2.3-1.3l2.3 1 2-3.4-2-1.5A7 7 0 0 0 19 12z"/>') %>
  <%= link_to edit_user_registration_path, class: "nav-link", style: "font-size:12px;" do %>
    <span class="nav-icon"><%= ico.call('<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>') %></span>
    <span style="overflow:hidden;text-overflow:ellipsis"><%= current_user.email %></span>
  <% end %>
  <%= button_to destroy_user_session_path, method: :delete, class: "nav-link", style: "width:100%; background:none; border:none; text-align:left; cursor:pointer;", form: { data: { turbo_confirm: "Bạn muốn đăng xuất khỏi T0 Trader?" } } do %>
    <span class="nav-icon"><%= ico.call('<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>') %></span>
    <span>Đăng xuất</span>
  <% end %>
</aside>
