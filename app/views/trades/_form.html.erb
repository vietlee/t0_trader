<% rates = current_user.fee_rates %>
<%= form_with model: trade, url: (trade.persisted? ? trade_path(trade) : trades_path), method: (trade.persisted? ? :patch : :post),
      data: { controller: "trade-form",
              trade_form_buy_fee_value: rates[:buy_fee_rate],
              trade_form_sell_fee_value: rates[:sell_fee_rate],
              trade_form_sell_tax_value: rates[:sell_tax_rate] } do |f| %>

  <% if trade.errors.any? %>
    <div class="flash flash-alert">
      <%= trade.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="form-row" style="grid-template-columns: 1fr 1fr;">
    <div>
      <%= f.label :symbol, "Mã cổ phiếu", class: "form-label" %>
      <div class="ac-wrap" data-controller="autocomplete" data-autocomplete-url-value="<%= symbols_search_path %>">
        <%= f.text_field :symbol, value: trade.stock&.symbol, class: "form-input", style: "text-transform:uppercase",
              placeholder: "Gõ mã hoặc tên...", autocomplete: "off", autofocus: true,
              data: { autocomplete_target: "input", action: "input->autocomplete#onInput keydown->autocomplete#onKey" } %>
        <div class="ac-list" data-autocomplete-target="list"></div>
      </div>
    </div>
    <div>
      <%= f.label :side, "Loại lệnh", class: "form-label" %>
      <%= f.select :side, [["MUA", "buy"], ["BÁN", "sell"]], {}, class: "form-select",
            data: { trade_form_target: "side", action: "trade-form#recalc" } %>
    </div>
  </div>

  <div class="form-row mt-4" style="grid-template-columns: 1fr 1fr;">
    <div>
      <%= f.label :quantity, "Khối lượng (CP)", class: "form-label" %>
      <%= f.text_field :quantity, value: trade.quantity, inputmode: "numeric", class: "form-input", placeholder: "1.000",
            data: { controller: "numeric-input", trade_form_target: "quantity", action: "input->numeric-input#format input->trade-form#recalc" } %>
    </div>
    <div>
      <%= f.label :price, "Giá khớp (đ/CP)", class: "form-label" %>
      <%= f.text_field :price, value: trade.price&.to_i, inputmode: "numeric", class: "form-input", placeholder: "25.000",
            data: { controller: "numeric-input", trade_form_target: "price", action: "input->numeric-input#format input->trade-form#recalc" } %>
    </div>
  </div>

  <div class="form-row mt-4" style="grid-template-columns: 1fr 1fr;">
    <div>
      <%= f.label :traded_at, "Thời điểm khớp", class: "form-label" %>
      <%= f.datetime_local_field :traded_at, value: trade.traded_at&.strftime("%Y-%m-%dT%H:%M"), class: "form-input" %>
      <div class="form-hint">Ngày về (T+2) sẽ tự tính theo lịch HOSE.</div>
    </div>
    <div>
      <%= f.label :status, "Trạng thái", class: "form-label" %>
      <%= f.select :status, Trade.statuses.keys.map { |s| [ApplicationHelper::STATUS_LABELS[s], s] }, {}, class: "form-select" %>
    </div>
  </div>

  <div class="form-row mt-4" style="grid-template-columns: 1fr 1fr;">
    <div>
      <%= f.label :fee, "Phí giao dịch (đ)", class: "form-label" %>
      <%= f.text_field :fee, value: trade.fee&.to_i, inputmode: "numeric", class: "form-input",
            data: { controller: "numeric-input", trade_form_target: "fee", action: "input->numeric-input#format input->trade-form#markFee input->trade-form#recalc" } %>
      <div class="form-hint" data-trade-form-target="feeHint"></div>
    </div>
    <div>
      <%= f.label :tax, "Thuế bán (đ)", class: "form-label" %>
      <%= f.text_field :tax, value: trade.tax&.to_i, inputmode: "numeric", class: "form-input",
            data: { controller: "numeric-input", trade_form_target: "tax", action: "input->numeric-input#format input->trade-form#markTax input->trade-form#recalc" } %>
      <div class="form-hint">Chỉ áp dụng khi bán (0,1%).</div>
    </div>
  </div>

  <div class="form-row mt-4" style="grid-template-columns: 1fr 1fr;">
    <div>
      <%= f.label :strategy_tag, "Chiến lược / nhãn", class: "form-label" %>
      <%= f.text_field :strategy_tag, class: "form-input", list: "tags-list", placeholder: "T+0, Swing, Đầu tư...", autocomplete: "off" %>
      <datalist id="tags-list">
        <% current_account.trades.where.not(strategy_tag: [nil, ""]).distinct.pluck(:strategy_tag).each do |t| %><option value="<%= t %>"></option><% end %>
      </datalist>
    </div>
    <div>
      <%= f.label :note, "Ghi chú", class: "form-label" %>
      <%= f.text_field :note, class: "form-input", placeholder: "Lý do vào lệnh..." %>
    </div>
  </div>

  <div class="card mt-5" style="background:rgba(7,10,18,.5); display:flex; justify-content:space-between; align-items:center;">
    <div>
      <div style="font-size:12px;color:#8595b4">Giá trị lệnh</div>
      <div style="font-size:19px;font-weight:700" data-trade-form-target="gross">0</div>
    </div>
    <div style="text-align:right">
      <div style="font-size:12px;color:#8595b4">Dòng tiền ròng</div>
      <div style="font-size:19px;font-weight:700" data-trade-form-target="net">0</div>
    </div>
  </div>

  <div class="flex items-center gap-3 mt-5">
    <%= f.submit (trade.persisted? ? "Lưu thay đổi" : "Ghi giao dịch"), class: "btn btn-primary" %>
    <% unless trade.persisted? %>
      <%= f.submit "Ghi & nhập tiếp", name: "continue", class: "btn btn-ghost" %>
    <% end %>
    <%= link_to "Huỷ", trades_path, class: "btn btn-ghost" %>
  </div>
<% end %>
