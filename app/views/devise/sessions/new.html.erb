<% content_for :title, "Đăng nhập · T0 Trader" %>
<h2 style="font-size:18px;font-weight:700;margin-bottom:4px">Đăng nhập</h2>
<p style="font-size:13px;color:#8595b4;margin-bottom:18px">Truy cập bảng điều khiển giao dịch của bạn.</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="mb-4">
    <%= f.label :email, "Email", class: "form-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", placeholder: "you@example.com" %>
  </div>
  <div class="mb-4">
    <%= render "shared/password_field", f: f, method: :password, label: "Mật khẩu", autocomplete: "current-password" %>
    <% if devise_mapping.recoverable? %>
      <div style="text-align:right;margin-top:6px">
        <%= link_to "Quên mật khẩu?", new_password_path(resource_name), style: "font-size:12.5px;color:#8595b4" %>
      </div>
    <% end %>
  </div>
  <% if devise_mapping.rememberable? %>
    <label class="flex items-center gap-2 mb-5" style="cursor:pointer;font-size:13.5px;color:#c7d3e8">
      <%= f.check_box :remember_me %> Ghi nhớ đăng nhập
    </label>
  <% end %>
  <%= f.submit "Đăng nhập", class: "btn btn-primary", style: "width:100%; justify-content:center" %>
<% end %>

<% if devise_mapping.registerable? %>
  <div style="text-align:center; margin-top:16px; font-size:13.5px; color:#8595b4">
    Chưa có tài khoản? <%= link_to "Đăng ký ngay", new_registration_path(resource_name), style: "color:#6ee7b7; font-weight:600" %>
  </div>
<% end %>
