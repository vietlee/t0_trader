<% content_for :title, "Quên mật khẩu · T0 Trader" %>
<h2 style="font-size:18px;font-weight:700;margin-bottom:4px">Quên mật khẩu?</h2>
<p style="font-size:13px;color:#8595b4;margin-bottom:18px">Nhập email — chúng tôi sẽ gửi link đặt lại mật khẩu.</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div class="mb-5">
    <%= f.label :email, "Email", class: "form-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", placeholder: "you@example.com" %>
  </div>
  <%= f.submit "Gửi link đặt lại", class: "btn btn-primary", style: "width:100%; justify-content:center" %>
<% end %>

<div style="text-align:center; margin-top:16px; font-size:13.5px; color:#8595b4">
  <%= link_to "← Quay lại đăng nhập", new_session_path(resource_name), style: "color:#6ee7b7; font-weight:600" %>
</div>
